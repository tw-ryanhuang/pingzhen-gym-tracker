{
  "name": "pingzhen-gym-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 0-13,22-23 * * *",
      "50,55 21 * * *",
      "0,5,15 14 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pingzhen-gym",
      "database_id": "b8a840b8-1fe2-4dbf-b8ce-5c7981a0a18b"
    }
  ]
}
